---
/* KIT — segmented control. Replaces radio groups; reads as a real control
   rather than browser-default radios, which is most of why calculator sites
   look unfinished. */
interface Props {
  name: string;
  label?: string;
  value: string | number;
  options: Array<{ value: string | number; label: string }>;
}
const { name, label, value, options } = Astro.props;
---
<div class="field">
  {label && <span class="field__label"><span>{label}</span></span>}
  <div class="segmented" role="radiogroup" aria-label={label ?? name}>
    {options.map((o) => (
      <label class="segmented__opt">
        <input type="radio" name={`seg-${name}`} data-field={name}
               value={String(o.value)} checked={String(o.value) === String(value)} />
        <span>{o.label}</span>
      </label>
    ))}
  </div>
</div>
